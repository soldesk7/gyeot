# .env로 복사한 뒤 실제 값을 채워 넣으세요. .env 자체는 커밋하지 않습니다.
# Vite는 VITE_ 접두사가 붙은 값만 클라이언트 번들에 노출합니다 — 절대 서버 전용 키(Gemini·공공데이터)를 여기 넣지 마세요.

# 카카오맵 JS 키 — 도메인 제한 등록으로 노출 리스크를 낮춘, 프론트에서 써도 되는 유일한 키
VITE_KAKAO_MAP_KEY=

# Vite 프록시를 쓰므로 비워 둔다.(null이 아닌 빈 문자열 취급) 휴대폰 시연 시 localhost:8080을 넣으면 안 된다.
VITE_BFF_BASE_URL=
